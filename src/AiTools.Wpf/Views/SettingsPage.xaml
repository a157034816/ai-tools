<UserControl x:Class="AiTools.Wpf.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cfg="clr-namespace:AiTools.Wpf.Configuration"
             xmlns:vm="clr-namespace:AiTools.Wpf.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1080"
             d:DesignHeight="760"
             d:DataContext="{x:Static vm:SettingsViewModel.DesignInstance}"
             MinWidth="640">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AiTools.Wpf;component/Themes/DarkTheme.xaml" />
                <ResourceDictionary Source="/AiTools.Wpf;component/Themes/Converters.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 服务商列表项：选中时使用强调色边框与淡色背景 -->
            <Style x:Key="Settings_ProviderListItem" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,8">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSubtleBrush}" />
                                    <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 连接测试状态文本：根据测试状态着色 -->
            <Style x:Key="Settings_TestStatusText" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="10,0,0,0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding TestState}" Value="{x:Static vm:ConnectionTestState.Running}">
                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding TestState}" Value="{x:Static vm:ConnectionTestState.Succeeded}">
                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding TestState}" Value="{x:Static vm:ConnectionTestState.Failed}">
                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- 模型行容器 -->
            <Style x:Key="Settings_ModelRow" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>

            <!-- 小号图标按钮（上移/下移） -->
            <Style x:Key="Settings_ReorderButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="MinWidth" Value="20" />
                <Setter Property="Focusable" Value="False" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}" TextElement.FontFamily="{StaticResource UiFont}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="24,20,24,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="设置" Style="{StaticResource SectionTitle}" Margin="0" />
                    <Border Style="{StaticResource Badge}" Margin="10,0,0,0">
                        <TextBlock Text="{Binding ProviderCountText}" Style="{StaticResource BadgeText}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="管理服务商、模型与对话默认提示词。更改在点击「保存设置」后生效。"
                           Style="{StaticResource Caption}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="重新加载"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ReloadCommand}"
                        Margin="0,0,8,0" />
                <Button Content="保存设置"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveCommand}" />
            </StackPanel>
        </Grid>

        <!-- 未初始化提示 -->
        <Border Grid.Row="1"
                Margin="24,0,24,12"
                Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource WarningBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8"
                Visibility="{Binding IsAvailable, Converter={StaticResource InverseBoolToVisibility}}">
            <TextBlock Text="AiToolsWpf 尚未初始化，设置页处于只读预览模式。请在应用启动时调用 AiToolsWpf.Initialize(options)。"
                       Foreground="{StaticResource WarningBrush}"
                       FontFamily="{StaticResource UiFont}"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </Border>

        <!-- 删除确认条（库内不使用阻塞式对话框） -->
        <Border Grid.Row="2"
                Margin="24,0,24,12"
                Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8"
                Visibility="{Binding HasPendingDelete, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextBrush}"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="12"
                           TextWrapping="Wrap">
                    <Run Text="确认删除服务商「" />
                    <Run Text="{Binding PendingDeleteName, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="」？该操作在保存后生效。" />
                </TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button Content="取消"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding CancelDeleteCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="确认删除"
                            Style="{StaticResource DangerButton}"
                            Command="{Binding ConfirmDeleteCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体：左侧服务商列表，右侧编辑区 -->
        <Grid Grid.Row="3" Margin="24,0,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="272" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="2,2,2,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="服务商" Style="{StaticResource CardTitle}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ProviderCountText}"
                                   Style="{StaticResource Hint}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <ListBox ItemsSource="{Binding Providers}"
                                 SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource Settings_ProviderListItem}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ProviderEditorViewModel}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding HeaderText}"
                                                       Foreground="{StaticResource TextBrush}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0">
                                                <Button Content="↑"
                                                        Style="{StaticResource Settings_ReorderButton}"
                                                        ToolTip="上移"
                                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="↓"
                                                        Style="{StaticResource Settings_ReorderButton}"
                                                        ToolTip="下移"
                                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding StatusText}"
                                                   Style="{StaticResource Hint}"
                                                   Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="还没有服务商，请从下方模板添加。"
                                   Style="{StaticResource Hint}"
                                   Margin="4,8,4,0"
                                   VerticalAlignment="Top"
                                   Visibility="{Binding HasProviders, Converter={StaticResource InverseBoolToVisibility}}" />
                    </Grid>

                    <StackPanel Grid.Row="2">
                        <Border Style="{StaticResource Divider}" Margin="0,10" />
                        <TextBlock Text="添加服务商" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Descriptors}"
                                  SelectedItem="{Binding SelectedDescriptor, Mode=TwoWay}"
                                  ItemContainerStyle="{StaticResource ComboItem}"
                                  Style="{StaticResource ComboField}"
                                  Margin="0,0,0,6">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type cfg:ProviderDescriptor}">
                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="{StaticResource TextBrush}"
                                               FontFamily="{StaticResource UiFont}"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding SelectedDescriptorDescription}"
                                   Style="{StaticResource Hint}"
                                   Margin="0,0,0,8"
                                   Visibility="{Binding SelectedDescriptorDescription, Converter={StaticResource StringToVisibility}}" />
                        <Button Content="添加到列表"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding AddSelectedDescriptorCommand}"
                                HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右侧 -->
            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,4,0">
                <StackPanel>
                    <!-- 未选择服务商时的占位 -->
                    <Border Style="{StaticResource Card}"
                            VerticalAlignment="Top"
                            Visibility="{Binding HasSelectedProvider, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="尚未选择服务商" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="在左侧选择一个服务商进行编辑，或从模板添加新的服务商。"
                                       Style="{StaticResource Caption}"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 服务商编辑区 -->
                    <StackPanel Visibility="{Binding HasSelectedProvider, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource Card}" DataContext="{Binding SelectedProvider}">
                            <StackPanel>
                                <!-- 编辑区标题 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding HeaderText}" Style="{StaticResource CardTitle}" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="ID" Style="{StaticResource Hint}" />
                                            <TextBlock Text="{Binding Id}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="11"
                                                       Margin="6,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource Badge}" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource BadgeText}" />
                                    </Border>
                                </Grid>

                                <Border Style="{StaticResource Divider}" />

                                <!-- 基本信息 -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="显示名称" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource TextField}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="协议" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding ProtocolOptions}"
                                                  SelectedItem="{Binding Protocol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemContainerStyle="{StaticResource ComboItem}"
                                                  Style="{StaticResource ComboField}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="API Base URL" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextField}"
                                         FontFamily="{StaticResource MonoFont}"
                                         Margin="0,0,0,10" />
                                <TextBlock Text="例如 https://api.openai.com/v1。OpenAI 兼容端点请填写到 /v1。"
                                           Style="{StaticResource Hint}"
                                           Margin="0,-6,0,12" />

                                <!-- API Key -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="API Key" Style="{StaticResource FieldLabel}" />
                                    <CheckBox Grid.Column="1"
                                              Content="显示明文"
                                              Style="{StaticResource ToggleField}"
                                              IsChecked="{Binding IsApiKeyVisible, Mode=TwoWay}"
                                              Margin="0,-3,0,0" />
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <TextBox Text="{Binding MaskedApiKey, Mode=OneWay}"
                                             Style="{StaticResource TextField}"
                                             FontFamily="{StaticResource MonoFont}"
                                             IsReadOnly="True"
                                             IsTabStop="False"
                                             Cursor="Hand"
                                             ToolTip="勾选「显示明文」后可编辑 API Key"
                                             Visibility="{Binding IsApiKeyVisible, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource TextField}"
                                             FontFamily="{StaticResource MonoFont}"
                                             Visibility="{Binding IsApiKeyVisible, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                                <TextBlock Text="默认设置存储会使用 Windows DPAPI 加密保存 API Key。本地端点（localhost）可不填写。"
                                           Style="{StaticResource Hint}"
                                           Margin="0,-4,0,10" />

                                <CheckBox Content="启用此服务商"
                                          Style="{StaticResource ToggleField}"
                                          IsChecked="{Binding Enabled, Mode=TwoWay}"
                                          Margin="0,2,0,4" />

                                <Border Style="{StaticResource Divider}" />

                                <!-- 连接测试 -->
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="测试连接"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding DataContext.TestConnectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock Text="{Binding TestStatus}"
                                               Style="{StaticResource Settings_TestStatusText}"
                                               Visibility="{Binding TestStatus, Converter={StaticResource StringToVisibility}}" />
                                </StackPanel>

                                <Border Style="{StaticResource Divider}" />

                                <!-- 模型 -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="模型" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="仅启用且填写了 ID 的模型会显示在对话页。"
                                                   Style="{StaticResource Hint}"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <Button Grid.Column="1"
                                            Content="+ 添加模型"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding DataContext.AddModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>

                                <!-- 从服务商接口获取模型列表 -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="获取模型列表"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding DataContext.FetchModelsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding CanFetchModels}" />
                                    <TextBlock Text="{Binding ModelFetchStatus}"
                                               Style="{StaticResource Settings_TestStatusText}"
                                               Visibility="{Binding ModelFetchStatus, Converter={StaticResource StringToVisibility}}" />
                                </StackPanel>

                                <!-- 候选模型选择面板 -->
                                <Border x:Name="ModelPickerPanel"
                                        Background="{StaticResource BackgroundBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10"
                                        Margin="0,0,0,10"
                                        Visibility="{Binding IsModelPickerOpen, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="可用模型" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding FetchedSelectionText}"
                                                           Style="{StaticResource Hint}"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="关闭"
                                                    Style="{StaticResource GhostButton}"
                                                    Command="{Binding DataContext.CloseModelPickerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>

                                        <TextBox Text="{Binding ModelFilterText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource TextField}"
                                                 Padding="8,6"
                                                 Margin="0,0,0,8"
                                                 ToolTip="按模型 ID 或显示名称过滤" />

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <Button Content="全选"
                                                        Style="{StaticResource GhostButton}"
                                                        Command="{Binding DataContext.SelectAllFetchedModelsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="0,0,8,0" />
                                                <Button Content="全不选"
                                                        Style="{StaticResource GhostButton}"
                                                        Command="{Binding DataContext.SelectNoFetchedModelsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="添加勾选的模型"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Command="{Binding DataContext.ApplyFetchedModelsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>

                                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding FetchedModels}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:FetchedModelRowViewModel}">
                                                        <Border Background="{StaticResource SurfaceBrush}"
                                                                CornerRadius="4"
                                                                Padding="8,5"
                                                                Margin="0,0,0,4">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <CheckBox Grid.Column="0"
                                                                          Style="{StaticResource ToggleField}"
                                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                          VerticalAlignment="Center"
                                                                          Margin="0,0,8,0" />
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Id}"
                                                                               Foreground="{StaticResource TextBrush}"
                                                                               FontFamily="{StaticResource MonoFont}"
                                                                               FontSize="12"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding DisplayName}"
                                                                               Style="{StaticResource Hint}"
                                                                               Visibility="{Binding HasDisplayName, Converter={StaticResource BoolToVisibility}}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <Border Grid.Column="2"
                                                                        Style="{StaticResource Badge}"
                                                                        Margin="8,0,0,0"
                                                                        Visibility="{Binding IsAlreadyConfigured, Converter={StaticResource BoolToVisibility}}">
                                                                    <TextBlock Text="已配置" Style="{StaticResource BadgeText}" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <TextBlock Margin="2,4,0,0"
                                                   Text="没有匹配的模型，请调整筛选条件或重新获取。"
                                                   Visibility="{Binding HasFetchedModels, Converter={StaticResource InverseBoolToVisibility}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasFetchedAnyModels}" Value="False">
                                                            <Setter Property="Text" Value="服务商没有返回任何模型。" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="4,0,4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="模型 ID" Style="{StaticResource Hint}" Margin="2,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="显示名称" Style="{StaticResource Hint}" Margin="2,0,8,0" ToolTip="留空时显示模型 ID" />
                                    <TextBlock Grid.Column="2" Text="启用" Style="{StaticResource Hint}" Width="48" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="3" Text="操作" Style="{StaticResource Hint}" Width="52" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Models}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ModelRowViewModel}">
                                            <Border Style="{StaticResource Settings_ModelRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0"
                                                             Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource TextField}"
                                                             FontFamily="{StaticResource MonoFont}"
                                                             Padding="8,6"
                                                             Margin="0,0,8,0" />
                                                    <TextBox Grid.Column="1"
                                                             Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource TextField}"
                                                             Padding="8,6"
                                                             Margin="0,0,8,0" />
                                                    <CheckBox Grid.Column="2"
                                                              Style="{StaticResource ToggleField}"
                                                              IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                              Width="48"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,8,0"
                                                              ToolTip="在对话页中显示此模型" />
                                                    <Button Grid.Column="3"
                                                            Content="移除"
                                                            Style="{StaticResource DangerButton}"
                                                            Width="52"
                                                            Padding="4,4"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding DataContext.RemoveModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="没有模型时，请至少添加一个模型 ID 再保存。"
                                           Style="{StaticResource Hint}"
                                           Margin="2,2,0,0" />

                                <Border Style="{StaticResource Divider}" />

                                <Button Content="删除此服务商"
                                        Style="{StaticResource DangerButton}"
                                        HorizontalAlignment="Left"
                                        Command="{Binding DataContext.RemoveProviderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 对话默认设置（全宽） -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="24,12,24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="对话默认设置" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                        <Border Style="{StaticResource Badge}" Margin="10,0,0,0">
                            <TextBlock Text="系统提示词" Style="{StaticResource BadgeText}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="用于新会话；留空时使用宿主配置的默认提示词。"
                               Style="{StaticResource Hint}"
                               Margin="0,2,0,0" />
                    <TextBox Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MultilineField}"
                             Height="96"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,8,0,4" />
                    <TextBlock Text="{Binding DefaultSystemPromptHint}"
                               Style="{StaticResource Hint}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                    <Button Content="恢复默认"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding ResetSystemPromptCommand}"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,2" />
                    <Button Content="保存设置"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveCommand}"
                            HorizontalAlignment="Right"
                            Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 底部状态栏 -->
        <Border Grid.Row="5"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,10"
                Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Style="{StaticResource Caption}"
                           VerticalAlignment="Center"
                           MaxHeight="54"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding StatusMessage}"
                           Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="保存中…"
                               Style="{StaticResource Caption}"
                               Foreground="{StaticResource WarningBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Visibility="{Binding IsSaving, Converter={StaticResource BoolToVisibility}}" />
                    <Border Style="{StaticResource Badge}"
                            Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="未保存的更改"
                                   Style="{StaticResource BadgeText}"
                                   Foreground="{StaticResource WarningBrush}" />
                    </Border>
                    <Button Content="放弃更改并重新加载"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding ReloadCommand}"
                            Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
