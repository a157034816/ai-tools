<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <RootNamespace>AiTools.Extensions</RootNamespace>
    <AssemblyName>AiTools.Extensions</AssemblyName>
    <Version>0.1.0</Version>
    <Description>Claude Code compatible plugin framework for AiTools: manifests, slash commands, skills and MCP server declarations.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- workflows 扩展：纯托管 JS 解释器（netstandard2.0 可用）。 -->
    <PackageReference Include="Jint" Version="4.17.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AiTools.Skills\AiTools.Skills.csproj" />
    <ProjectReference Include="..\AiTools.Mcp\AiTools.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
