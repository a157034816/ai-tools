    <ProjectReference Include="..\AiTools.Extensions.Scripting\AiTools.Extensions.Scripting.csproj" />
    <ProjectReference Include="..\AiTools.Mcp\AiTools.Mcp.csproj" />
    <ProjectReference Include="..\AiTools.Skills\AiTools.Skills.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AiTools.Tests" />
  </ItemGroup>

</Project>
