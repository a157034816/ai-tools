<Window x:Class="AiTools.Samples.McpToolServer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AiTools.Samples.McpToolServer.ViewModels"
        xmlns:local="clr-namespace:AiTools.Samples.McpToolServer"
        Title="MCP 工具服务"
        Width="1100" Height="760" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Grid Margin="18,16,18,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="18,14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MCP 工具服务" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                    <Border Margin="12,0,0,0" Padding="9,3" CornerRadius="10"
                            Background="{Binding StatusBadgeBackground}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusText}" Margin="6,0,0,0" FontSize="12"
                                       Foreground="{Binding StatusBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="端点" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Endpoint}" Margin="6,0,0,0" FontSize="12"
                                   FontFamily="{StaticResource MonoFont}"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Content="复制" Style="{StaticResource GhostButton}" Margin="4,0,0,0"
                                Click="OnCopyEndpointClick" ToolTip="复制端点 URL" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="PID" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PidText}" Margin="6,0,0,0" FontSize="11"
                                   FontFamily="{StaticResource MonoFont}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="·" Margin="8,0" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                        <TextBlock Text="{Binding ServerName}" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" MinWidth="104"
                        Content="{Binding PrimaryActionText}"
                        IsEnabled="{Binding CanToggleService}"
                        Click="OnToggleServiceClick" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 主体 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="300" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- 左：工具目录 -->
            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,14,16,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="工具目录" Style="{StaticResource SectionTitle}" />
                            <Border Margin="8,1,0,0" Padding="7,2" CornerRadius="9"
                                    Background="{StaticResource SurfaceAltBrush}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ToolCount}" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="来自 ToolDefinition" Style="{StaticResource Hint}" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="12,0,8,12">
                        <ItemsControl ItemsSource="{Binding Tools}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ToolCardViewModel}">
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                        <StackPanel>
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Name}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentBrush}" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Title}"
                                                           FontSize="11" HorizontalAlignment="Right"
                                                           Foreground="{StaticResource TextMutedBrush}" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}"
                                                       Margin="0,4,0,0" />
                                            <ItemsControl ItemsSource="{Binding Parameters}"
                                                          Margin="0,8,0,0"
                                                          Visibility="{Binding ParametersVisibility}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:ToolParameterViewModel}">
                                                        <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                                                            <TextBlock Text="{Binding Name}" FontSize="11"
                                                                       FontFamily="{StaticResource MonoFont}"
                                                                       Foreground="{StaticResource TextBrush}" />
                                                            <TextBlock Text="{Binding SummaryText}" Margin="8,0,0,0"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource TextMutedBrush}" />
                                                            <TextBlock Text="{Binding Description}" Margin="8,0,0,0"
                                                                       FontSize="11" MaxWidth="140"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{StaticResource TextMutedBrush}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="无参数" Style="{StaticResource Hint}" Margin="0,6,0,0"
                                                       Visibility="{Binding NoParametersVisibility}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 右：日志 + 自测 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" MinHeight="200" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="2*" MinHeight="180" />
                </Grid.RowDefinitions>

                <!-- 实时请求日志 -->
                <Border Grid.Row="0" Style="{StaticResource Panel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="16,13,12,9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="实时请求日志" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="最多保留 500 条" Style="{StaticResource Hint}"
                                           Margin="10,3,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <CheckBox Style="{StaticResource ToggleField}" Content="自动滚动"
                                          IsChecked="{Binding IsLogAutoScroll}" VerticalAlignment="Center"
                                          Margin="0,0,10,0" />
                                <Button Content="清空" Style="{StaticResource GhostButton}"
                                        Click="OnClearLogsClick" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="16,0,16,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="时间" Style="{StaticResource Hint}" />
                            <TextBlock Grid.Column="1" Text="方法" Style="{StaticResource Hint}" />
                            <TextBlock Grid.Column="2" Text="工具" Style="{StaticResource Hint}" />
                            <TextBlock Grid.Column="3" Text="耗时" Style="{StaticResource Hint}" />
                            <TextBlock Grid.Column="4" Text="状态" Style="{StaticResource Hint}" />
                        </Grid>

                        <Border Grid.Row="2" BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="0,1,0,0">
                            <ListBox x:Name="LogList" ItemsSource="{Binding Logs}"
                                     Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource LogListItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:RequestLogEntry}">
                                        <Grid Margin="16,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="92" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="84" />
                                                <ColumnDefinition Width="150" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding TimeText}" FontSize="11"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Method}" FontSize="11"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{StaticResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding ToolText}" FontSize="11"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{Binding DurationText}" FontSize="11"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Grid.Column="4" Text="{Binding Outcome}" FontSize="11"
                                                       Foreground="{Binding StatusBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                </Border>

                <!-- 内置自测 -->
                <Border Grid.Row="2" Style="{StaticResource Panel}">
                    <Grid Margin="16,13,16,13">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="内置自测" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="无需外部客户端即可验证工具" Style="{StaticResource Hint}"
                                           Margin="10,3,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding ToolResultStatus}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" FontSize="12"
                                       Foreground="{Binding ToolResultBrush}" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" Style="{StaticResource ComboField}"
                                      ItemContainerStyle="{StaticResource ComboItem}"
                                      ItemsSource="{Binding Tools}"
                                      SelectedItem="{Binding SelectedTool, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ToolCardViewModel}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource MonoFont}" />
                                            <TextBlock Text="{Binding Title}" Margin="8,0,0,0"
                                                       Foreground="{StaticResource TextMutedBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="调用工具"
                                    Margin="8,0,0,0" MinWidth="96"
                                    IsEnabled="{Binding CanInvokeTool}"
                                    Click="OnInvokeToolClick" />
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="270" MinWidth="200" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding SelectedTool.Parameters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ToolParameterViewModel}">
                                            <StackPanel Margin="0,0,0,7">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource FieldLabel}"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               Foreground="{StaticResource TextBrush}" />
                                                    <TextBlock Text="{Binding SummaryText}" Margin="7,0,0,0"
                                                               Style="{StaticResource Hint}" />
                                                </StackPanel>
                                                <StackPanel Visibility="{Binding SingleLineInputVisibility}">
                                                    <TextBox Style="{StaticResource TextField}" Margin="0,3,0,0"
                                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Visibility="{Binding MultilineInputVisibility}">
                                                    <TextBox Style="{StaticResource MultilineField}" Margin="0,3,0,0"
                                                             Height="56"
                                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <ComboBox Style="{StaticResource ComboField}" Margin="0,3,0,0"
                                                          Visibility="{Binding EnumInputVisibility}"
                                                          ItemContainerStyle="{StaticResource ComboItem}"
                                                          ItemsSource="{Binding Options}"
                                                          SelectedItem="{Binding SelectedOption, Mode=TwoWay}" />
                                                <CheckBox Style="{StaticResource ToggleField}" Content="启用"
                                                          Margin="0,4,0,0"
                                                          Visibility="{Binding BoolInputVisibility}"
                                                          IsChecked="{Binding BoolValue}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBox Grid.Column="2" Style="{StaticResource MultilineField}"
                                     Text="{Binding ToolResultText, Mode=OneWay}"
                                     IsReadOnly="True" FontFamily="{StaticResource MonoFont}"
                                     FontSize="12" VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                                     AcceptsReturn="True" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="注册表" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding RegistryPath}" Margin="6,0,0,0" FontSize="11"
                               FontFamily="{StaticResource MonoFont}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusDetail}" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="420" />
                    <TextBlock Text="·" Margin="8,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="请求" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding RequestCount}" Margin="5,0,0,0" FontSize="11"
                               FontFamily="{StaticResource MonoFont}"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="·" Margin="8,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="监听" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ListenAddress}" Margin="5,0,0,0" FontSize="11"
                               FontFamily="{StaticResource MonoFont}"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
