<Window x:Class="AiTools.Wpf.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:AiTools.Wpf.Views;assembly=AiTools.Wpf"
        Title="AiTools WPF 演示"
        Width="1280" Height="860"
        MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{DynamicResource UiFont}"
        Foreground="{DynamicResource TextBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部导航 -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="AiTools" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="WPF 预制组件演示" FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <RadioButton x:Name="ChatTab" Content="对话" GroupName="Nav" IsChecked="True"
                                 Style="{StaticResource NavTab}" Checked="ChatTab_Checked" />
                    <RadioButton x:Name="SettingsTab" Content="设置" GroupName="Nav"
                                 Style="{StaticResource NavTab}" Checked="SettingsTab_Checked" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 页面容器 -->
        <Grid Grid.Row="1">
            <wpf:ChatPage x:Name="ChatView" />
            <wpf:SettingsPage x:Name="SettingsView" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
